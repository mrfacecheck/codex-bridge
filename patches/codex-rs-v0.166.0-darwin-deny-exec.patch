+/// Optional colon-delimited list of absolute paths or `.app` bundles whose
+/// execution (`process-exec`) is denied inside macOS Seatbelt before `execve`
+/// enters target user-space code.
+pub const CODEX_BRIDGE_DENY_EXEC_SUBPATHS_ENV_VAR: &str = "CODEX_BRIDGE_DENY_EXEC_SUBPATHS";
+const SEATBELT_ALLOW_PROCESS_EXEC_LINE: &str = "(allow process-exec)";
+
+fn deny_exec_subpaths_from_env() -> Vec<PathBuf> {
+    let Some(raw) = std::env::var_os(CODEX_BRIDGE_DENY_EXEC_SUBPATHS_ENV_VAR) else {
+        return Vec::new();
+    };
+    if raw.is_empty() {
+        return Vec::new();
+    }
+    std::env::split_paths(&raw)
+        .filter(|path| !path.as_os_str().is_empty())
+        .collect()
+}
+
+fn build_deny_exec_policy(
+    raw_paths: &[PathBuf],
+) -> Result<(String, Option<String>, Vec<(String, PathBuf)>), SeatbeltPreparationError> {
+    let mut normalized_paths = BTreeSet::new();
+    for raw_path in raw_paths {
+        if !raw_path.is_absolute() || raw_path == Path::new("/") {
+            warn!(
+                "ignoring invalid {CODEX_BRIDGE_DENY_EXEC_SUBPATHS_ENV_VAR} entry: {}",
+                raw_path.display()
+            );
+            continue;
+        }
+        let Ok(abs) = AbsolutePathBuf::from_absolute_path(raw_path) else {
+            warn!(
+                "ignoring unnormalizable {CODEX_BRIDGE_DENY_EXEC_SUBPATHS_ENV_VAR} entry: {}",
+                raw_path.display()
+            );
+            continue;
+        };
+        let logical = normalize_top_level_alias_for_sandbox(abs.clone()).unwrap_or(abs);
+        if logical.as_path() == Path::new("/") {
+            continue;
+        }
+        if let Some(resolved) = normalize_path_for_sandbox(logical.as_path())
+            && resolved.as_path() != Path::new("/")
+        {
+            normalized_paths.insert(resolved.into_path_buf());
+        }
+        normalized_paths.insert(logical.into_path_buf());
+    }
+
+    if normalized_paths.is_empty() {
+        return Ok((MACOS_SEATBELT_BASE_POLICY.to_string(), None, Vec::new()));
+    }
+
+    if !MACOS_SEATBELT_BASE_POLICY.contains(SEATBELT_ALLOW_PROCESS_EXEC_LINE) {
+        return Err(SeatbeltPreparationError::FileSystem(format!(
+            "cannot apply {CODEX_BRIDGE_DENY_EXEC_SUBPATHS_ENV_VAR}: base Seatbelt policy missing `{SEATBELT_ALLOW_PROCESS_EXEC_LINE}`"
+        )));
+    }
+
+    let params: Vec<(String, PathBuf)> = normalized_paths
+        .into_iter()
+        .enumerate()
+        .map(|(index, path)| (format!("DENY_EXEC_{index}"), path))
+        .collect();
+
+    let require_not_clauses = params
+        .iter()
+        .flat_map(|(key, _)| {
+            [
+                format!("(require-not (literal (param \"{key}\")))"),
+                format!("(require-not (subpath (param \"{key}\")))"),
+            ]
+        })
+        .collect::<Vec<_>>()
+        .join("\n    ");
+    let narrowed_allow_exec =
+        format!("(allow process-exec\n  (require-all\n    {require_not_clauses}))");
+    let base_policy =
+        MACOS_SEATBELT_BASE_POLICY.replace(SEATBELT_ALLOW_PROCESS_EXEC_LINE, &narrowed_allow_exec);
+
+    let deny_clauses = params
+        .iter()
+        .flat_map(|(key, _)| {
+            [
+                format!("(literal (param \"{key}\"))"),
+                format!("(subpath (param \"{key}\"))"),
+            ]
+        })
+        .collect::<Vec<_>>()
+        .join("\n  ");
+    let trailing_deny = format!("(deny process-exec\n  {deny_clauses})");
+
+    Ok((base_policy, Some(trailing_deny), params))
+}

+#[test]
+fn build_deny_exec_policy_narrows_allow_and_appends_deny_for_multiple_paths() {
+    let (base, trailing, params) = super::build_deny_exec_policy(&[
+        PathBuf::from("/Applications/Google Chrome.app"),
+        PathBuf::from("/bin/echo"),
+        PathBuf::from("/"),
+        PathBuf::from("relative/ignored"),
+    ])
+    .expect("build deny exec policy");
+
+    assert!(
+        !base.contains("\n(allow process-exec)\n"),
+        "unconditional allow process-exec must be replaced:\n{base}"
+    );
+    assert!(base.contains("(allow process-exec\n  (require-all"));
+    assert!(base.contains("(require-not (subpath (param \"DENY_EXEC_0\")))"));
+    assert!(base.contains("(require-not (subpath (param \"DENY_EXEC_1\")))"));
+    let trailing = trailing.expect("trailing deny policy");
+    assert!(trailing.contains("(deny process-exec"));
+    assert!(trailing.contains("(subpath (param \"DENY_EXEC_0\"))"));
+    assert!(trailing.contains("(subpath (param \"DENY_EXEC_1\"))"));
+    assert_eq!(params.len(), 2);
+}

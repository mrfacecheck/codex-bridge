+#[test]
+fn seatbelt_denies_process_exec_for_configured_subpaths_at_kernel_boundary() {
+    let tmp = TempDir::new().expect("tempdir");
+    let fs_policy = FileSystemSandboxPolicy::from_legacy_sandbox_policy_for_cwd(
+        &SandboxPolicy::new_read_only_policy(),
+        tmp.path(),
+    );
+    let denied = vec![
+        PathBuf::from("/Applications/Google Chrome.app"),
+        PathBuf::from("/bin/echo"),
+    ];
+    let denied_args = super::create_seatbelt_command_args_with_profile_and_deny_exec(
+        CreateSeatbeltCommandArgsParams {
+            command: vec!["/bin/echo".to_string(), "should-not-run".to_string()],
+            file_system_sandbox_policy: &fs_policy,
+            network_sandbox_policy: NetworkSandboxPolicy::Restricted,
+            sandbox_policy_cwd: tmp.path(),
+            enforce_managed_network: false,
+            managed_network: None,
+            environment_id: None,
+            network: None,
+            extra_allow_unix_sockets: &[],
+        },
+        super::MacosSeatbeltProfile::Process,
+        /*allowed_symlinked_codex_home*/ None,
+        &denied,
+    )
+    .expect("create seatbelt args with deny_exec");
+
+    let output = Command::new(MACOS_PATH_TO_SEATBELT_EXECUTABLE)
+        .args(denied_args)
+        .current_dir(tmp.path())
+        .output()
+        .expect("run sandbox-exec for denied /bin/echo");
+    let stderr = String::from_utf8_lossy(&output.stderr);
+    if stderr.contains("sandbox-exec: sandbox_apply: Operation not permitted") {
+        return;
+    }
+    assert!(
+        !output.status.success(),
+        "denied binary /bin/echo unexpectedly succeeded: {output:?}"
+    );
+    assert!(
+        stderr.contains("Operation not permitted"),
+        "expected EPERM from kernel Seatbelt, got: {stderr}"
+    );
+
+    let allowed_args = super::create_seatbelt_command_args_with_profile_and_deny_exec(
+        CreateSeatbeltCommandArgsParams {
+            command: vec!["/usr/bin/true".to_string()],
+            file_system_sandbox_policy: &fs_policy,
+            network_sandbox_policy: NetworkSandboxPolicy::Restricted,
+            sandbox_policy_cwd: tmp.path(),
+            enforce_managed_network: false,
+            managed_network: None,
+            environment_id: None,
+            network: None,
+            extra_allow_unix_sockets: &[],
+        },
+        super::MacosSeatbeltProfile::Process,
+        /*allowed_symlinked_codex_home*/ None,
+        &denied,
+    )
+    .expect("create seatbelt args for allowed binary");
+    let ok_output = Command::new(MACOS_PATH_TO_SEATBELT_EXECUTABLE)
+        .args(allowed_args)
+        .current_dir(tmp.path())
+        .output()
+        .expect("run sandbox-exec for /usr/bin/true");
+    assert!(
+        ok_output.status.success(),
+        "allowed binary /usr/bin/true unexpectedly failed: {ok_output:?}"
+    );
+}
